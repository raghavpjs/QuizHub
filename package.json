  "description": "Backend API for a simple Quiz Website (student/lecturer roles) built with Node.js, Express and MongoDB.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --runInBand"
